{
  "name": "discord-date-party-bot",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "description": "Discord 約會與 Party 揪團機器人",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "commands:register": "node dist/src/register-commands.js",
    "commands:register:dev": "tsx src/register-commands.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "discord.js": "^14.21.0",
    "dotenv": "^17.2.1",
    "prisma": "^6.14.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^22.17.1",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
